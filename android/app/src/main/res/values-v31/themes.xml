<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TonalSort" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/wallpaper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ launch splash: the icon on the wallpaper blue -->
        <item name="android:windowSplashScreenBackground">@color/wallpaper</item>
    </style>
</resources>
